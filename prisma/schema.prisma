// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Session {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionId String   @unique
  phoneNumber String?
  isActive  Boolean  @default(true)
  authData  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  Message[]
}

model Message {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  
  key       Json
  message   Json
  messageTimestamp BigInt

  fromMe    Boolean
  pushName  String?

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([createdAt])
}

model BotConfig {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Session Metadata ────────────────────────────────────────────
model WaSession {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionId          String   @unique
  phoneNumber        String?
  status             String   @default("disconnected")
  isActive           Boolean  @default(false)

  lastConnectedAt    DateTime?
  lastDisconnectedAt DateTime?
  lastQrAt           DateTime?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  authStates         WaAuthState[]
}

// ─── Baileys Auth State ──────────────────────────────────────────
model WaAuthState {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionId String
  type      String
  key       String
  value     Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session   WaSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)

  @@unique([sessionId, type, key])
  @@index([sessionId])
}

// ─── User & Premium ──────────────────────────────────────────────
model User {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  userId         String      @unique
  pushName       String?
  sessionId      String?
  tier           String      @default("free")
  premiumExpiry  DateTime?
  status         String      @default("active")
  isBlocked      Boolean     @default(false)
  aiModeEnabled  Boolean     @default(false)
  firstSeen      DateTime    @default(now())
  lastSeen       DateTime    @default(now())
  messageCount   Int         @default(1)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  usageLogs      UsageLog[]

  @@index([sessionId])
  @@index([lastSeen])
  @@index([tier])
  @@index([status])
}

// ─── Usage Tracking ──────────────────────────────────────────────
model UsageLog {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String
  date           String
  aiChatCount    Int      @default(0)
  groupAiCount   Int      @default(0)
  commandCount   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

// ─── Dashboard Activity & Command Logs ─────────────────────────────
model ActivityEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  type      String
  sessionId String?
  session   String?
  detail    String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([sessionId, createdAt])
}

model CommandLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionId String?
  userId    String?
  command   String
  args      String?
  success   Boolean  @default(true)
  latencyMs Int?
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([command, createdAt])
  @@index([createdAt])
}

model ToolCallLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionId String?
  userId    String?
  tool      String
  args      String?
  success   Boolean  @default(true)
  cached    Boolean  @default(false)
  latencyMs Int?
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([tool, createdAt])
  @@index([createdAt])
}

model HttpLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  method     String
  path       String
  status     Int
  durationMs Int?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([method, createdAt])
  @@index([status, createdAt])
}
