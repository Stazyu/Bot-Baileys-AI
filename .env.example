# Database Configuration
DATABASE_URL="mongodb://username:password@localhost:27017/bot_baileys?authSource=admin"

# Bot Configuration (optional)
BOT_NAME="Bot-Baileys-AI"

# Session filters (comma-separated session ids)
# Leave empty to load every saved session.
# EXCLUDE_SESSIONS: skip these when auto-loading from DB (e.g. exclude 'dev' in production Docker)
# INCLUDE_SESSIONS: only load these (overrides EXCLUDE_SESSIONS)
# EXCLUDE_SESSIONS="dev"
# INCLUDE_SESSIONS=""

# Owner Configuration (comma-separated WhatsApp numbers with @s.whatsapp.net)
OWNER_NUMBERS="628123456789@s.whatsapp.net"

# Prefix Configuration (comma-separated prefixes)
PREFIXES="!,.,#,/"

# Logger Configuration
LOG_LEVEL="silent"  # Options: trace, debug, info, warn, error, fatal, silent
NODE_ENV="production"  # Options: development, production — production = trace HTTP per-request tidak dicetak (terminal & viewer web)

# AI Provider Configuration
# Options: "openai" | "openrouter" | "ollama" | "other"
AI_PROVIDER="openai"

# ─── OpenAI-Compatible API (used when AI_PROVIDER=openai) ──────────
# Works with any OpenAI-compatible API (Groq, Together,
# DeepSeek, Mistral AI, Azure OpenAI, etc.).
# Just set BASE_URL, API_KEY, and MODEL according to your provider.
OPENAI_BASE_URL="https://api.openai.com/v1"      # Replace with your API base URL
OPENAI_API_KEY="sk-********************************"  # Your API key
OPENAI_MODEL="gpt-4o-mini"  # The model you want to use

# Generic fallback (used if OPENAI_* or OPENROUTER_* are not set)
# AI_BASE_URL="https://api.openai.com/v1"
# AI_API_KEY="sk-..."
# AI_MODEL="gpt-4o-mini"

# ─── OpenRouter AI Configuration (used when AI_PROVIDER=openrouter) ─
OPENROUTER_API_KEY="sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="anthropic/claude-3-haiku"

# ─── Other Provider Configuration (used when AI_PROVIDER=other) ────
# For a custom OpenAI-compatible API. Use the BASE_URL and API_KEY
# from any provider that supports the OpenAI format (Groq, Together,
# DeepSeek, Mistral AI, Azure OpenAI, etc.).
OTHER_BASE_URL="https://api.custom-service.com/v1"   # Replace with your API base URL
OTHER_API_KEY="sk-your-api-key-here"                   # Your API key
OTHER_MODEL="custom-model-name"                        # The model you want to use

# ─── Ollama Configuration (used when AI_PROVIDER=ollama) ────────────
# Example: http://localhost:11434 or http://your-ollama-host:11434
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="glm-5.1:cloud"

# ─── Firecrawl Web Fetch Configuration ──────────────────────────────
# Firecrawl instance URL for the web_fetch tool (web page scraping).
# Firecrawl is a headless browser scraper that can grab content
# from modern websites (including SPA/JS-heavy ones).
FIRECRAWL_URL="https://firecrawl.wahyuhp.my.id" // Replace with your Firecrawl instance URL (self-hosted or cloud). Leave empty to disable web_fetch.

# ─── TStickers (Telegram Sticker Pack Tool) ───────────────────────────────
# Convert Telegram sticker packs (https://t.me/addstickers/<name>) into
# WhatsApp sticker packs via the `!tgstickerpack` plugin.
# Install the CLI: python -m pip install tstickers  (requires Python 3.8-3.11)
#
# Telegram bot token is REQUIRED — create one via @BotFather.
TELEGRAM_BOT_TOKEN="1234567890:AAExampleTokenFromBotFather"
# Fallback alias for the same token (used when TELEGRAM_BOT_TOKEN is empty).
# TSTICKERS_TOKEN="1234567890:AAExampleTokenFromBotFather"
# Path to the tstickers binary when it is not on PATH (e.g. "python -m tstickers").
# TSTICKERS_BIN="tstickers"
# Download+conversion process timeout in ms (default: 300000 = 5 minutes).
# TSTICKERS_TIMEOUT_MS="300000"
# ffmpeg binary for webm → animated webp conversion (only when a pack outputs
# webm only). Make sure ffmpeg is installed: https://ffmpeg.org/download.html
# FFMPEG_BIN="ffmpeg"
# Per-file webm conversion timeout in ms (default: 120000 = 2 minutes).
# TSTICKERS_FFMPEG_TIMEOUT_MS="120000"
#
# Quality & speed of webm → animated webp conversion. Animated conversion is slow
# because it scales with frame count × compression, NOT file size. The defaults
# are already optimized (~21× faster than the maximum quality setting):
# compression_level 4 + fps 20.
# Raise compression_level (max 6) or fps for higher quality, but conversion
# becomes much slower.
# TSTICKERS_WEBP_QUALITY="90"
# TSTICKERS_WEBP_COMPRESSION="4"
# TSTICKERS_WEBP_FPS="20"
#
# Parallel conversion: how many ffmpeg processes run at once to process
# many webm stickers. Each ffmpeg is single-threaded, so parallelism
# cuts time ~linearly on multi-core machines. Default 4 (1-8).
# TSTICKERS_CONCURRENCY="4"

# ─── gallery-dl Sticker Tool ────────────────────────────────────────
# Install locally: python -m pip install -U gallery-dl
# Windows can also use Chocolatey/Scoop. Set GALLERY_DL_BIN if the binary
# is not on PATH.
GALLERY_DL_BIN="gallery-dl"
GALLERY_DL_TIMEOUT_MS="90000"
# Plain queries like "cat" will be inserted into this template.
GALLERY_DL_SEARCH_TEMPLATE="https://www.pinterest.com/search/pins/?q={query}"
# Optional: cookies.txt for sites that require login.
# GALLERY_DL_COOKIES="C:\\path\\to\\cookies.txt"

# ─── Instagram / yt-dlp Cookies ──────────────────────────────────────
# Two modes (pick one; browser mode takes priority):
#
# Mode 1: Auto-extract from browser (recommended, no file needed)
#   INSTAGRAM_DL_COOKIES_BROWSER="chrome"
#   Supported: chrome, firefox, edge, opera, brave, vivaldi
#
# Mode 2: Manual cookies.txt (Netscape format)
#   Export using the "Get cookies.txt LOCALLY" extension, or:
#   yt-dlp --cookies-from-browser chrome --cookies cookies.txt
#   then set:
#   INSTAGRAM_DL_COOKIES="C:\\path\\to\\cookies.txt"
#   (fallback: YTDLP_COOKIES)
INSTAGRAM_DL_COOKIES_BROWSER="chrome"

# ─── Dashboard API (Fastify, same process as the bot) ────────────────
# API port/host. Default HOST 127.0.0.1 (local only); set 0.0.0.0 if
# accessed from another machine / reverse proxy.
PORT="3001"
# HOST="127.0.0.1"
# Single personal-panel token. Empty = no auth (local dev only).
DASHBOARD_API_TOKEN="replace-with-random-32-character-token"
# Dev frontend origins, comma-separated. Empty = allow all.
CORS_ORIGIN="http://localhost:5173"
# ActivityEvent + CommandLog retention (days), pruned hourly.
ACTIVITY_RETENTION_DAYS="30"
# Version shown on the dashboard.
BOT_VERSION="2.0.0"
