# Production static server untuk dashboard (SPA vue-router history mode).
#
# TLS + domain dipegang Traefik (Coolify); Caddy di sini hanya serve file
# di :80 dalam network Docker. Otomatis HTTPS mati karena site address
# tidak punya hostname.
:80 {
	root * /srv
	encode zstd gzip

	# Aset Vite punya hash di nama file → aman di-cache lama.
	# handle = mutually exclusive: request /assets/* berhenti di sini,
	# jadi file yang tidak ada di dist benar-benar 404, tidak jatuh ke
	# index.html (kalau jatuh, browser kena "HTML bukan JS").
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Sisanya (index.html, favicon, manifest) → jangan di-cache, supaya
	# deploy baru langsung kepakai.
	handle {
		header Cache-Control "no-cache"

		# Route tak dikenal → index.html (biar /sessions, /logs/xxx jalan).
		try_files {path} /index.html
		file_server
	}
}
